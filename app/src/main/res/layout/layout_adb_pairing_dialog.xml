<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pairing"
        style="@style/MaterialAlertDialog.Material3.Title.Text"
        android:layout_marginBottom="12dp"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="To start pairing, go to: Developer options > Wireless debugging > Pair device with pairing code"
        style="@style/MaterialAlertDialog.Material3.Body.Text"
        />

    <LinearLayout
        android:id="@+id/waiting_for_pairing_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_margin="24dp"
            >

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="waiting for pairing to start"
                style="@style/MaterialAlertDialog.Material3.Body.Text"
                />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/pairing_code_entry_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginVertical="24dp"
        android:visibility="gone"
        tools:visibility="visible"
        >

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter the pairing code below"
            style="@style/MaterialAlertDialog.Material3.Body.Text"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            >

            <EditText
                android:id="@+id/pairing_code_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="pairing code"
                android:autofillHints=""
                android:inputType="number"
                />

            <ImageButton
                android:id="@+id/pairing_code_submit_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:contentDescription="submit"
                android:src="@android:drawable/ic_menu_send"
                />

        </LinearLayout>
    </LinearLayout>
</LinearLayout>